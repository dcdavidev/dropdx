{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@dcdavidev/tsconfig/node-lib.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
