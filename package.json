{
  "name": "@dcdavidev/dropdx",
  "version": "0.3.0",
  "description": "Automated release and publish CLI for single packages and monorepos",
  "keywords": [
    "release",
    "publish",
    "npm",
    "npmjs",
    "dropdx"
  ],
  "homepage": "https://github.com/dcdavidev/dropdx#readme",
  "bugs": {
    "url": "https://github.com/dcdavidev/dropdx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcdavidev/dropdx.git"
  },
  "license": "MIT",
  "author": "Davide Di Criscito <dcdavidev@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dropdx": "bin/dropdx.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "pnpm run build && pnpm run lint && pnpm run spellcheck && pnpm run test",
    "check:ci": "pnpm run build && pnpm run lint:check && pnpm run fmt:check && pnpm run spellcheck && pnpm run test",
    "commit": "cz",
    "commit:lint": "commitlint --from=HEAD~1",
    "fmt": "prettier --ignore-unknown --write .",
    "fmt:check": "prettier --ignore-unknown --check .",
    "lint": "eslint --no-warn-ignored --fix .",
    "lint:check": "eslint --no-warn-ignored .",
    "prepack": "pnpm run build",
    "prepare": "lefthook install",
    "release": "pnpm run build && node bin/dropdx.js",
    "spellcheck": "cspell --no-progress --no-summary .",
    "test": "pnpm run build && node --test"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@cspell/dict-it-it": "^3.1.7",
    "@dcdavidev/tsconfig": "^0.1.0",
    "@spellbookx/recipes": "^1.1.0",
    "@types/node": "^26.6.5",
    "commitizen": "^4.3.2",
    "commitlint-config-spellbookx": "^1.0.2",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "cspell": "^10.4.0",
    "cspell-config-spellbookx": "^1.0.2",
    "cz-git": "^1.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-spellbookx": "^1.1.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-config-spellbookx": "^1.0.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.14.0",
  "publishConfig": {
    "access": "public"
  }
}
