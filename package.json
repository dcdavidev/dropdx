{
  "name": "@dcdavidev/dropdx",
  "version": "0.4.0",
  "description": "Automated release and publish CLI for single packages and monorepos",
  "keywords": [
    "release",
    "publish",
    "npm",
    "npmjs",
    "dropdx"
  ],
  "homepage": "https://github.com/dcdavidev/dropdx#readme",
  "bugs": {
    "url": "https://github.com/dcdavidev/dropdx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcdavidev/dropdx.git"
  },
  "license": "MIT",
  "author": "Davide Di Criscito <info@dcdavidev.com>",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dropdx": "bin/dropdx.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "changeset": "changeset",
    "changeset:commits": "changeset-conventional",
    "changeset:version": "changeset version",
    "check": "turbo run build lint:code lint:spelling lint:types fmt:check test",
    "commit": "czg",
    "fmt": "prettier --ignore-unknown --write .",
    "fmt:check": "prettier --ignore-unknown --check .",
    "lint": "turbo run lint:code lint:spelling",
    "lint:code": "eslint --no-warn-ignored .",
    "lint:code:fix": "eslint --no-warn-ignored --fix .",
    "lint:commits": "commitlint --from=HEAD~1 --verbose",
    "lint:spelling": "cspell --no-progress --no-summary .",
    "lint:types": "tsc --noEmit",
    "prepack": "pnpm run build",
    "prepare": "lefthook install",
    "release": "pnpm run build && node bin/dropdx.js",
    "test": "vitest run --no-fsModuleCache --passWithNoTests --coverage",
    "update:node": "pnpm exec tsx ./scripts/update-node.ts",
    "update:turbo": "pnpm exec tsx ./scripts/update-turbo.ts"
  },
  "dependencies": {
    "cosmiconfig": "9.0.2",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@spellbookx/recipes": "^2.1.3",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "changeset-conventional-commits": "^1.0.4",
    "commitlint-config-spellbookx": "^2.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "cspell": "^10.5.2",
    "cspell-config-spellbookx": "^2.1.3",
    "cz-config-spellbookx": "^2.1.3",
    "czg": "^1.14.0",
    "eslint": "^10.15.0",
    "eslint-plugin-spellbookx": "^2.1.3",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "prettier-config-spellbookx": "^2.1.3",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0",
  "publishConfig": {
    "access": "public"
  }
}
